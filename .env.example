# Leave OPENAI_API_KEY unset to run the offline keyword classifier (demo mode).
# Set it and the service switches to real OpenAI calls with strict structured output.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Retry budget for a single classification, and per-request timeout in seconds.
MAX_ATTEMPTS=3
REQUEST_TIMEOUT=20

# SQLite file. Use /tmp on Cloud Run; mount a volume for anything long-lived.
DB_PATH=triage.db

# How long a content fingerprint blocks a repeat delivery.
DEDUPE_TTL_HOURS=24
